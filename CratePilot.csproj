<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>CratePilot</AssemblyName>
    <RootNamespace>CratePilot</RootNamespace>
    <Version>1.0.0</Version>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('Branding\CratePilot.ico')">Branding\CratePilot.ico</ApplicationIcon>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <NuGetAudit>false</NuGetAudit>
    <NetFxReferencePath>$(MSBuildProgramFiles32)\Reference Assemblies\Microsoft\Framework\.NETFramework\v4.8</NetFxReferencePath>
    <WinRTSupportPath>$(SystemRoot)\Microsoft.NET\Framework64\v4.0.30319\System.Runtime.WindowsRuntime.dll</WinRTSupportPath>
    <WinRTMetadataPath Condition="'$(WinRTMetadataPath)' == '' And Exists('$(MSBuildProgramFiles32)\Windows Kits\10\UnionMetadata\10.0.26100.0\Windows.winmd')">$(MSBuildProgramFiles32)\Windows Kits\10\UnionMetadata\10.0.26100.0\Windows.winmd</WinRTMetadataPath>
  </PropertyGroup>
  <PropertyGroup Condition="Exists('PortableOcr\Native\x64') And Exists('PortableOcr\Native\x86')">
    <PortableX64EngineCount>$([System.IO.Directory]::GetFiles('$(MSBuildProjectDirectory)\PortableOcr\Native\x64', '*tesseract*.dll').Length)</PortableX64EngineCount>
    <PortableX86EngineCount>$([System.IO.Directory]::GetFiles('$(MSBuildProjectDirectory)\PortableOcr\Native\x86', '*tesseract*.dll').Length)</PortableX86EngineCount>
    <PlatformTarget Condition="'$(PortableX64EngineCount)' != '0' And '$(PortableX86EngineCount)' != '0'">AnyCPU</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Runtime.WindowsRuntime">
      <HintPath>$(WinRTSupportPath)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Runtime">
      <HintPath>$(NetFxReferencePath)\Facades\System.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Runtime.InteropServices.WindowsRuntime">
      <HintPath>$(NetFxReferencePath)\Facades\System.Runtime.InteropServices.WindowsRuntime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Threading.Tasks">
      <HintPath>$(NetFxReferencePath)\Facades\System.Threading.Tasks.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Windows" Condition="Exists('$(WinRTMetadataPath)')">
      <HintPath>$(WinRTMetadataPath)</HintPath>
      <IsWinMDFile>true</IsWinMDFile>
      <Private>false</Private>
    </Reference>
    <Reference Include="$(SystemRoot)\System32\WinMetadata\*.winmd" Condition="!Exists('$(WinRTMetadataPath)')">
      <IsWinMDFile>true</IsWinMDFile>
      <Private>false</Private>
    </Reference>
    <None Remove="Branding\CratePilot.png" />
    <Resource Include="Branding\CratePilot.png" Condition="Exists('Branding\CratePilot.png')" />
    <Resource Include="Branding\CratePilot.ico" Condition="Exists('Branding\CratePilot.ico')" />
    <EmbeddedResource Include="Branding\LICENSE.txt" Condition="Exists('Branding\LICENSE.txt')">
      <LogicalName>CratePilot.Branding.LICENSE.txt</LogicalName>
    </EmbeddedResource>
    <None Remove="PortableOcr\Native\**\*;PortableOcr\Data\eng.traineddata;PortableOcr\Licenses\**\*" />
    <EmbeddedResource Include="PortableOcr\Native\x64\*">
      <LogicalName>CratePilot.PortableOcr.Native.x64.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="PortableOcr\Native\x86\*">
      <LogicalName>CratePilot.PortableOcr.Native.x86.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="PortableOcr\Data\eng.traineddata" Condition="Exists('PortableOcr\Data\eng.traineddata')">
      <LogicalName>CratePilot.PortableOcr.Data.eng.traineddata</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="PortableOcr\Licenses\**\*">
      <LogicalName>CratePilot.PortableOcr.Licenses.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <Target Name="CheckOfflineBuildPrerequisites" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(NetFxReferencePath)\PresentationFramework.dll')" Text="Install the .NET Framework 4.8 Developer Pack. Reference assemblies are required for an offline build." />
    <Error Condition="!Exists('$(WinRTSupportPath)')" Text="The Windows .NET Framework WinRT support assembly is missing: $(WinRTSupportPath)." />
    <Error Condition="!Exists('$(WinRTMetadataPath)') And !Exists('$(SystemRoot)\System32\WinMetadata\Windows.Media.winmd')" Text="Windows SDK WinRT metadata or Windows 10/11 system WinMetadata is required." />
  </Target>
</Project>
