<Window x:Class="CratePilot.MainWindow" x:Name="AppWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="CratePilot" Width="880" Height="560" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource CanvasBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Tahoma" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True" Topmost="False">
    <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" /></shell:WindowChrome.WindowChrome>
    <Border x:Name="WindowFrame" CornerRadius="0" BorderBrush="{StaticResource DeepShadowBrush}" BorderThickness="0,0,1,1" Background="{StaticResource CanvasBrush}">
        <Border BorderBrush="{StaticResource HighlightBrush}" BorderThickness="1,1,0,0" Padding="3">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="Auto" /><RowDefinition Height="76" /><RowDefinition Height="*" /><RowDefinition Height="60" /><RowDefinition Height="28" /></Grid.RowDefinitions>
            <Border Background="{StaticResource TitleBrush}" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="12,0,4,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32" Height="32" Background="{StaticResource InsetBrush}" BorderBrush="{StaticResource DeepShadowBrush}" BorderThickness="1,1,0,0" Margin="0,0,12,0"><Image Source="{StaticResource PixelAppIcon}" Width="24" Height="24" IsHitTestVisible="False" /></Border>
                        <TextBlock Text="CratePilot" FontSize="18" FontWeight="Bold" Foreground="{StaticResource SelectionTextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource ChromeButton}" Click="Minimize_Click" ToolTip="Minimizar" AutomationProperties.Name="Minimizar janela" Margin="0,0,4,0"><Image Source="{StaticResource PixelMinimize}" Width="16" Height="16" /></Button>
                        <Button Style="{StaticResource ChromeButton}" Click="Maximize_Click" ToolTip="Maximizar ou restaurar" AutomationProperties.Name="Maximizar ou restaurar janela" Margin="0,0,4,0"><Image Source="{StaticResource PixelMaximize}" Width="16" Height="16" /></Button>
                        <Button Style="{StaticResource ChromeButton}" Click="Close_Click" ToolTip="Parar e fechar" AutomationProperties.Name="Parar e fechar CratePilot"><Image Source="{StaticResource PixelClose}" Width="16" Height="16" /></Button>
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" Style="{StaticResource Card}" Background="{StaticResource InsetBrush}" Padding="12,8" Margin="16,8,16,0" ToolTip="{Binding StatusMessage}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Rectangle Width="6" Height="6" Margin="0,0,8,0"><Rectangle.Style><Style TargetType="Rectangle"><Setter Property="Fill" Value="{StaticResource SubtleBrush}" /><Style.Triggers><DataTrigger Binding="{Binding StatusTone}" Value="active"><Setter Property="Fill" Value="{StaticResource AccentBrush}" /></DataTrigger><DataTrigger Binding="{Binding StatusTone}" Value="success"><Setter Property="Fill" Value="{StaticResource SuccessBrush}" /></DataTrigger><DataTrigger Binding="{Binding StatusTone}" Value="warning"><Setter Property="Fill" Value="{StaticResource WarningBrush}" /></DataTrigger><DataTrigger Binding="{Binding StatusTone}" Value="error"><Setter Property="Fill" Value="{StaticResource DangerBrush}" /></DataTrigger></Style.Triggers></Style></Rectangle.Style></Rectangle>
                            <TextBlock x:Name="CompactStatusTitle" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis" ToolTip="{Binding ConnectionDetails}"><TextBlock.Text><MultiBinding Converter="{StaticResource CompactStatusTitle}" Mode="OneWay"><Binding Path="StateLabel" /><Binding Path="StatusTitle" /><Binding Path="IsPaused" /><Binding Path="ConnectionLabel" /></MultiBinding></TextBlock.Text></TextBlock>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Recognition}" Foreground="{StaticResource SubtleBrush}" FontFamily="Consolas" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center" ToolTip="Tempo da última leitura OCR local" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" MaxHeight="72" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="14,4,0,0">
                        <ScrollViewer.Style><Style TargetType="ScrollViewer"><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=OperationalStatusDetail}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
                        <TextBlock x:Name="OperationalStatusDetail" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="20"><TextBlock.Text><MultiBinding Converter="{StaticResource CompactStatusDetail}" Mode="OneWay"><Binding Path="StatusMessage" /><Binding Path="StatusTone" /><Binding Path="StateLabel" /><Binding Path="IsPaused" /></MultiBinding></TextBlock.Text></TextBlock>
                    </ScrollViewer>
                </Grid>
            </ContentControl>

            <ContentControl Grid.Row="2" Style="{StaticResource Card}" Padding="8" Margin="16,8,16,0">
                <UniformGrid Columns="4">
                    <Border Style="{StaticResource InsetFrame}" Margin="0,0,8,0" Padding="8,0"><StackPanel><TextBlock Text="{Binding Opened}" Style="{StaticResource MetricValue}" /><TextBlock Text="Abertas" FontSize="14" Foreground="{StaticResource MutedBrush}" /></StackPanel></Border>
                    <Border Style="{StaticResource InsetFrame}" Margin="0,0,8,0" Padding="8,0"><StackPanel><TextBlock Text="{Binding Remaining}" Style="{StaticResource MetricValue}" /><TextBlock Text="Estoque" FontSize="14" Foreground="{StaticResource MutedBrush}" /></StackPanel></Border>
                    <Border Style="{StaticResource InsetFrame}" Margin="0,0,8,0" Padding="8,0"><StackPanel><TextBlock Text="{Binding Clicks}" Style="{StaticResource MetricValue}" /><TextBlock Text="Cliques" FontSize="14" Foreground="{StaticResource MutedBrush}" /></StackPanel></Border>
                    <Border Style="{StaticResource InsetFrame}" Padding="8,0"><StackPanel><TextBlock Text="{Binding Items}" Style="{StaticResource MetricValue}" /><TextBlock Text="Itens" FontSize="14" Foreground="{StaticResource MutedBrush}" /></StackPanel></Border>
                </UniformGrid>
            </ContentControl>
            <ScrollViewer x:Name="MainContentScroller" Grid.Row="3" Margin="16,8,16,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                <Grid MinHeight="{Binding ViewportHeight, ElementName=MainContentScroller}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition><ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value="300" /><Style.Triggers><DataTrigger Binding="{Binding IsNarrowLayout, ElementName=AppWindow}" Value="True"><Setter Property="Width" Value="*" /></DataTrigger></Style.Triggers></Style></ColumnDefinition.Style></ColumnDefinition>
                        <ColumnDefinition><ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value="12" /><Style.Triggers><DataTrigger Binding="{Binding IsNarrowLayout, ElementName=AppWindow}" Value="True"><Setter Property="Width" Value="0" /></DataTrigger></Style.Triggers></Style></ColumnDefinition.Style></ColumnDefinition>
                        <ColumnDefinition><ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value="*" /><Style.Triggers><DataTrigger Binding="{Binding IsNarrowLayout, ElementName=AppWindow}" Value="True"><Setter Property="Width" Value="0" /></DataTrigger></Style.Triggers></Style></ColumnDefinition.Style></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition><RowDefinition.Style><Style TargetType="RowDefinition"><Setter Property="Height" Value="*" /><Style.Triggers><DataTrigger Binding="{Binding IsNarrowLayout, ElementName=AppWindow}" Value="True"><Setter Property="Height" Value="Auto" /></DataTrigger></Style.Triggers></Style></RowDefinition.Style></RowDefinition>
                        <RowDefinition><RowDefinition.Style><Style TargetType="RowDefinition"><Setter Property="Height" Value="0" /><Style.Triggers><DataTrigger Binding="{Binding IsNarrowLayout, ElementName=AppWindow}" Value="True"><Setter Property="Height" Value="12" /></DataTrigger></Style.Triggers></Style></RowDefinition.Style></RowDefinition>
                        <RowDefinition><RowDefinition.Style><Style TargetType="RowDefinition"><Setter Property="Height" Value="0" /><Style.Triggers><DataTrigger Binding="{Binding IsNarrowLayout, ElementName=AppWindow}" Value="True"><Setter Property="Height" Value="Auto" /></DataTrigger></Style.Triggers></Style></RowDefinition.Style></RowDefinition>
                    </Grid.RowDefinitions>

                    <ContentControl Style="{StaticResource Card}" Padding="12,8" VerticalAlignment="Top">
                        <ScrollViewer x:Name="ConfigurationScroller" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition><ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value="0" /><Style.Triggers><DataTrigger Binding="{Binding IsNarrowLayout, ElementName=AppWindow}" Value="True"><Setter Property="Width" Value="16" /></DataTrigger></Style.Triggers></Style></ColumnDefinition.Style></ColumnDefinition>
                                    <ColumnDefinition><ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value="0" /><Style.Triggers><DataTrigger Binding="{Binding IsNarrowLayout, ElementName=AppWindow}" Value="True"><Setter Property="Width" Value="*" /></DataTrigger></Style.Triggers></Style></ColumnDefinition.Style></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /><RowDefinition><RowDefinition.Style><Style TargetType="RowDefinition"><Setter Property="Height" Value="8" /><Style.Triggers><DataTrigger Binding="{Binding IsNarrowLayout, ElementName=AppWindow}" Value="True"><Setter Property="Height" Value="0" /></DataTrigger></Style.Triggers></Style></RowDefinition.Style></RowDefinition><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.Style><Style TargetType="Grid"><Setter Property="Grid.ColumnSpan" Value="3" /><Style.Triggers><DataTrigger Binding="{Binding IsNarrowLayout, ElementName=AppWindow}" Value="True"><Setter Property="Grid.ColumnSpan" Value="1" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Pausa" FontWeight="Bold" VerticalAlignment="Center" />
                                    <Button x:Name="PauseBindingButton" Grid.Column="2" Content="{Binding BindingButtonLabel}" Click="ChangePauseKey_Click" IsEnabled="{Binding CanRebindPause, ElementName=AppWindow}" Padding="8" ToolTip="Alterar tecla de pausa (padrão F9). Use F1–F24 ou Ctrl/Alt + tecla; Esc cancela." AutomationProperties.Name="Alterar tecla de pausa" />
                                </Grid>
                                <StackPanel Grid.Row="2">
                                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Grid.ColumnSpan" Value="3" /><Style.Triggers><DataTrigger Binding="{Binding IsNarrowLayout, ElementName=AppWindow}" Value="True"><Setter Property="Grid.ColumnSpan" Value="1" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                    <Grid IsEnabled="{Binding CanConfigure}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><RadioButton Content="Auto" GroupName="CountMode" Style="{StaticResource ModeRadio}" IsChecked="{Binding AutomaticCount, Mode=TwoWay}" ToolTip="Ler o estoque visível e parar ao terminar." /><RadioButton Grid.Column="2" Content="Manual" GroupName="CountMode" Style="{StaticResource ModeRadio}" IsChecked="{Binding ManualCount, Mode=TwoWay}" ToolTip="Parar após abrir a quantidade definida." /></Grid>
                                    <Grid MinHeight="44" Margin="0,8,0,0" Visibility="{Binding ManualCount, Converter={StaticResource BooleanVisibility}}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="112" /></Grid.ColumnDefinitions><TextBlock Text="Caixas" VerticalAlignment="Center" /><TextBox x:Name="ManualLimitInput" Grid.Column="1" Width="112" Text="{Binding ManualLimitText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditManualCount}" MaxLength="7" InputMethod.IsInputMethodEnabled="False" PreviewTextInput="ManualLimit_PreviewTextInput" AutomationProperties.Name="Quantidade máxima de caixas" HorizontalContentAlignment="Right" FontFamily="Consolas" ToolTip="Máximo de caixas a abrir nesta sessão." /></Grid>
                                </StackPanel>
                                <StackPanel>
                                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Grid.Row" Value="4" /><Setter Property="Grid.ColumnSpan" Value="3" /><Style.Triggers><DataTrigger Binding="{Binding IsNarrowLayout, ElementName=AppWindow}" Value="True"><Setter Property="Grid.Row" Value="2" /><Setter Property="Grid.Column" Value="2" /><Setter Property="Grid.ColumnSpan" Value="1" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Intervalo" FontWeight="Bold" /><TextBlock Grid.Column="1" Text="{Binding TapIntervalLabel}" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" /></Grid>
                                    <Slider Minimum="1" Maximum="80" Value="{Binding TapInterval, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="5" IsEnabled="{Binding CanConfigure}" AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="0" AutomationProperties.Name="Intervalo entre cliques, de 1 a 80 milissegundos" ToolTip="Intervalo entre cliques (1 a 80 ms). Deixe em 8 ms ou menos para velocidade máxima." />
                                </StackPanel>
                                <CheckBox Content="Minimizar" IsChecked="{Binding MinimizeOnStart}" IsEnabled="{Binding CanConfigure}" ToolTip="Minimizar ao iniciar e restaurar somente ao terminar ou parar."><CheckBox.Style><Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="Grid.Row" Value="5" /><Setter Property="Grid.ColumnSpan" Value="3" /><Style.Triggers><DataTrigger Binding="{Binding IsNarrowLayout, ElementName=AppWindow}" Value="True"><Setter Property="Grid.Row" Value="0" /><Setter Property="Grid.Column" Value="2" /><Setter Property="Grid.ColumnSpan" Value="1" /></DataTrigger></Style.Triggers></Style></CheckBox.Style></CheckBox>
                            </Grid>
                        </ScrollViewer>
                    </ContentControl>

                    <ScrollViewer x:Name="DashboardScroller" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="Grid.Column" Value="2" /><Setter Property="Grid.Row" Value="0" /><Setter Property="MinHeight" Value="180" /><Setter Property="Height" Value="{Binding ViewportHeight, ElementName=MainContentScroller}" /><Style.Triggers><DataTrigger Binding="{Binding IsNarrowLayout, ElementName=AppWindow}" Value="True"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.Row" Value="2" /><Setter Property="Height" Value="200" /></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
                        <Grid MinHeight="180">
                            <ContentControl Style="{StaticResource Card}" Padding="12,8,12,12">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Atividade" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                                        <Button x:Name="CopyLogsButton" Grid.Column="1" Click="CopyLogs_Click" Padding="8" ToolTip="Copiar os registros em memória e o diagnóstico básico." AutomationProperties.Name="Copiar logs"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource PixelCopy}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" /><TextBlock Text="{Binding CopyButtonLabel}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" /></StackPanel></Button>
                                    </Grid>
                                    <Border Grid.Row="1" Style="{StaticResource InsetFrame}" Margin="0,4,0,0">
                                        <Grid>
                                            <ListBox x:Name="ActivityList" ItemsSource="{Binding Events}" BorderThickness="0" Background="{StaticResource InsetBrush}" Padding="4" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                <ListBox.ItemTemplate><DataTemplate><Grid Margin="4"><Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Time}" FontFamily="Consolas" FontSize="14" Margin="0,2,8,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource SubtleBrush}" /><Style.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Foreground" Value="{StaticResource SelectionTextBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" LineHeight="20"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}" /><Style.Triggers><DataTrigger Binding="{Binding Tone}" Value="error"><Setter Property="Foreground" Value="{StaticResource DangerBrush}" /></DataTrigger><DataTrigger Binding="{Binding Tone}" Value="warning"><Setter Property="Foreground" Value="{StaticResource WarningBrush}" /></DataTrigger><DataTrigger Binding="{Binding Tone}" Value="success"><Setter Property="Foreground" Value="{StaticResource SuccessBrush}" /></DataTrigger><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Foreground" Value="{StaticResource SelectionTextBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DataTemplate></ListBox.ItemTemplate>
                                            </ListBox>
                                            <TextBlock Text="Sem atividade" Foreground="{StaticResource SubtleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasEvents}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </ContentControl>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </ScrollViewer>

            <Grid Grid.Row="4" Margin="16,8,16,8">
                <Button x:Name="StartAutomationButton" Style="{StaticResource PrimaryButton}" Height="44" Click="Start_Click" IsEnabled="{Binding CanStartAutomation, ElementName=AppWindow}" Padding="8" AutomationProperties.Name="Iniciar ou pausar" ToolTip="Iniciar, pausar ou despausar a automação (F9)." ToolTipService.ShowOnDisabled="True">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Image Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Image.Style>
                                <Style TargetType="Image" BasedOn="{StaticResource {x:Type Image}}">
                                    <Setter Property="Source" Value="{StaticResource PixelPlayLight}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Source" Value="{StaticResource PixelPause}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                            <Setter Property="Source" Value="{StaticResource PixelPlayLight}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Button}}" Value="False">
                                            <Setter Property="Source" Value="{StaticResource PixelPlay}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <TextBlock Text="{Binding StartButtonLabel}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
            <Grid x:Name="FooterBar" Grid.Row="5" Margin="8,0,8,4"><Border Style="{StaticResource InsetFrame}" Background="{StaticResource PanelBrush}" Padding="8,2"><TextBlock Text="{Binding HotKeyHint}" Foreground="{StaticResource AccentBrush}" FontSize="14" VerticalAlignment="Center" /></Border></Grid>
        </Grid>
        </Border>
    </Border>
</Window>
