<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <LinearGradientBrush x:Key="CanvasBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#ECEBEB" Offset="0" /><GradientStop Color="#E9EDF5" Offset="0.6" /><GradientStop Color="#F1E8F0" Offset="1" /></LinearGradientBrush>
    <SolidColorBrush x:Key="PanelBrush" Color="#ECEBEB" />
    <SolidColorBrush x:Key="RaisedBrush" Color="#ECEBEB" />
    <SolidColorBrush x:Key="InsetBrush" Color="#FBFBFB" />
    <SolidColorBrush x:Key="LineBrush" Color="#AAAAAA" />
    <SolidColorBrush x:Key="TextBrush" Color="#2D2D2F" />
    <SolidColorBrush x:Key="MutedBrush" Color="#444348" />
    <SolidColorBrush x:Key="SubtleBrush" Color="#626268" />
    <SolidColorBrush x:Key="AccentBrush" Color="#165386" />
    <SolidColorBrush x:Key="AccentLineBrush" Color="#4F88E9" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#165386" />
    <SolidColorBrush x:Key="SelectionTextBrush" Color="#FBFBFB" />
    <SolidColorBrush x:Key="HighlightBrush" Color="#FBFBFB" />
    <SolidColorBrush x:Key="DeepShadowBrush" Color="#6E6E6E" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#23664F" />
    <SolidColorBrush x:Key="WarningBrush" Color="#8B5B13" />
    <SolidColorBrush x:Key="DangerBrush" Color="#A2334D" />
    <LinearGradientBrush x:Key="TitleBrush" StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#7C345F" Offset="0" /><GradientStop Color="#4F4A8D" Offset="0.45" /><GradientStop Color="#165386" Offset="1" /></LinearGradientBrush>
    <BooleanToVisibilityConverter x:Key="BooleanVisibility" />

    <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Tahoma" /><Setter Property="FontSize" Value="14" /><Setter Property="TextOptions.TextFormattingMode" Value="Display" /></Style>
    <Style TargetType="Image"><Setter Property="RenderOptions.EdgeMode" Value="Aliased" /><Setter Property="RenderOptions.BitmapScalingMode" Value="NearestNeighbor" /><Setter Property="SnapsToDevicePixels" Value="True" /></Style>
    <Style x:Key="KeyboardFocus" TargetType="Control"><Setter Property="Template"><Setter.Value><ControlTemplate><Rectangle Margin="3" Stroke="{StaticResource AccentBrush}" StrokeThickness="1" StrokeDashArray="1 1" /></ControlTemplate></Setter.Value></Setter></Style>

    <Style x:Key="BaseButton" TargetType="Button">
        <Setter Property="FontFamily" Value="Tahoma" /><Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Setter Property="Background" Value="{StaticResource RaisedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DeepShadowBrush}" /><Setter Property="MinHeight" Value="44" /><Setter Property="MinWidth" Value="44" />
        <Setter Property="Padding" Value="12,8" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="Button">
                <Border x:Name="OuterBevel" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,1,1" Background="{TemplateBinding Background}">
                    <Border x:Name="LightEdge" BorderBrush="{StaticResource HighlightBrush}" BorderThickness="1,1,0,0">
                        <Border x:Name="InnerShade" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,1">
                            <Grid>
                                <Border x:Name="HoverTint" Background="#164F88E9" Opacity="0" IsHitTestVisible="False" />
                                <ContentPresenter x:Name="ButtonContent" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
                                <Rectangle x:Name="FocusRing" Margin="4" Stroke="{TemplateBinding Foreground}" StrokeThickness="1" StrokeDashArray="1 1" Visibility="Collapsed" IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                    </Border>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="OuterBevel" Property="BorderBrush" Value="{StaticResource AccentBrush}" /><Setter TargetName="HoverTint" Property="Opacity" Value="1" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="LightEdge" Property="BorderBrush" Value="{StaticResource DeepShadowBrush}" /><Setter TargetName="InnerShade" Property="BorderBrush" Value="{StaticResource HighlightBrush}" /><Setter TargetName="ButtonContent" Property="RenderTransform"><Setter.Value><TranslateTransform X="1" Y="1" /></Setter.Value></Setter></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource MutedBrush}" /><Setter TargetName="OuterBevel" Property="Background" Value="#DADADA" /><Setter TargetName="OuterBevel" Property="BorderBrush" Value="{StaticResource LineBrush}" /><Setter TargetName="HoverTint" Property="Opacity" Value="0" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource BaseButton}" />
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}"><Setter Property="Background" Value="{StaticResource SelectionBrush}" /><Setter Property="Foreground" Value="{StaticResource SelectionTextBrush}" /></Style>
    <Style x:Key="ChromeButton" TargetType="Button" BasedOn="{StaticResource BaseButton}"><Setter Property="Padding" Value="12" /><Setter Property="Width" Value="44" /><Setter Property="Height" Value="44" /></Style>

    <Style x:Key="Card" TargetType="ContentControl">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" /><Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Setter Property="Focusable" Value="False" /><Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl">
            <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource DeepShadowBrush}" BorderThickness="0,0,1,1">
                <Border BorderBrush="{StaticResource HighlightBrush}" BorderThickness="1,1,0,0">
                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,1"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" /></Border>
                </Border>
            </Border>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="InsetFrame" TargetType="Border"><Setter Property="Background" Value="{StaticResource InsetBrush}" /><Setter Property="BorderBrush" Value="{StaticResource LineBrush}" /><Setter Property="BorderThickness" Value="1,1,0,0" /><Setter Property="CornerRadius" Value="0" /></Style>
    <Style x:Key="MetricValue" TargetType="TextBlock"><Setter Property="FontFamily" Value="Consolas" /><Setter Property="FontSize" Value="26" /><Setter Property="FontWeight" Value="Bold" /><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /><Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" /></Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="#FFFEF1" /><Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Setter Property="BorderBrush" Value="{StaticResource DeepShadowBrush}" /><Setter Property="FontFamily" Value="Tahoma" /><Setter Property="FontSize" Value="14" /><Setter Property="Padding" Value="8" /><Setter Property="MaxWidth" Value="380" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" TextWrapping="Wrap" Margin="{TemplateBinding Padding}" /></Border></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ContextMenu"><Setter Property="Background" Value="{StaticResource PanelBrush}" /><Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Setter Property="BorderBrush" Value="{StaticResource DeepShadowBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="FontFamily" Value="Tahoma" /><Setter Property="FontSize" Value="14" /><Setter Property="Padding" Value="2" /><Setter Property="HasDropShadow" Value="False" /></Style>
    <Style TargetType="MenuItem"><Setter Property="MinHeight" Value="44" /><Setter Property="Padding" Value="12,8" /><Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{StaticResource SelectionBrush}" /><Setter Property="Foreground" Value="{StaticResource SelectionTextBrush}" /></Trigger></Style.Triggers></Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="16" /><Setter Property="Background" Value="#E0DFE3" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
            <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0">
                <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                    <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False"><RepeatButton.Template><ControlTemplate><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb MinHeight="32"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="Grip" Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource DeepShadowBrush}" BorderThickness="0,0,1,1" Margin="1"><Border BorderBrush="{StaticResource HighlightBrush}" BorderThickness="1,1,0,0"><Grid VerticalAlignment="Center" Height="8" Margin="3,0"><Rectangle Height="1" Fill="{StaticResource LineBrush}" VerticalAlignment="Top" /><Rectangle Height="1" Fill="{StaticResource HighlightBrush}" VerticalAlignment="Center" /><Rectangle Height="1" Fill="{StaticResource LineBrush}" VerticalAlignment="Bottom" /></Grid></Border></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#E2EAF9" /></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="#CFDCF1" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False"><RepeatButton.Template><ControlTemplate><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
                </Track>
            </Border>
            <ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" /></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="ListBox"><Setter Property="FontFamily" Value="Tahoma" /><Setter Property="FontSize" Value="14" /><Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Setter Property="Background" Value="{StaticResource InsetBrush}" /><Setter Property="BorderBrush" Value="{StaticResource LineBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ScrollViewer Padding="{TemplateBinding Padding}" Focusable="False" CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}" HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}" VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"><ItemsPresenter /></ScrollViewer></Border></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ListBoxItem"><Setter Property="MinHeight" Value="44" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Background" Value="Transparent" /><Setter Property="Padding" Value="0" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="LogRow" Background="{TemplateBinding Background}"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="LogRow" Property="Background" Value="{StaticResource SelectionBrush}" /><Setter Property="Foreground" Value="{StaticResource SelectionTextBrush}" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="LogRow" Property="BorderBrush" Value="{StaticResource AccentLineBrush}" /><Setter TargetName="LogRow" Property="BorderThickness" Value="1" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>

    <Style x:Key="ModeRadio" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Setter Property="MinHeight" Value="44" /><Setter Property="FontFamily" Value="Tahoma" /><Setter Property="FontSize" Value="14" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
            <Border x:Name="ModeSurface" Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource DeepShadowBrush}" BorderThickness="0,0,1,1"><Border x:Name="ModeHighlight" BorderBrush="{StaticResource HighlightBrush}" BorderThickness="1,1,0,0"><Grid><ContentPresenter x:Name="ModeContent" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4" /><Rectangle x:Name="RadioFocusRing" Margin="4" Stroke="{TemplateBinding Foreground}" StrokeThickness="1" StrokeDashArray="1 1" Visibility="Collapsed" IsHitTestVisible="False" /></Grid></Border></Border>
            <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{StaticResource SelectionTextBrush}" /><Setter TargetName="ModeSurface" Property="Background" Value="{StaticResource SelectionBrush}" /><Setter TargetName="ModeHighlight" Property="BorderBrush" Value="{StaticResource DeepShadowBrush}" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="RadioFocusRing" Property="Visibility" Value="Visible" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ModeSurface" Property="BorderBrush" Value="{StaticResource AccentLineBrush}" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ModeContent" Property="RenderTransform"><Setter.Value><TranslateTransform X="1" Y="1" /></Setter.Value></Setter></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ModeSurface" Property="BorderBrush" Value="{StaticResource LineBrush}" /><Setter Property="Cursor" Value="Arrow" /></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="Tahoma" /><Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" /><Setter Property="SelectionBrush" Value="{StaticResource SelectionBrush}" /><Setter Property="SelectionTextBrush" Value="{StaticResource SelectionTextBrush}" /><Setter Property="Background" Value="{StaticResource InsetBrush}" /><Setter Property="MinHeight" Value="44" /><Setter Property="Padding" Value="12,8" /><Setter Property="FontSize" Value="16" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="InputSurface" Background="{TemplateBinding Background}" BorderBrush="{StaticResource DeepShadowBrush}" BorderThickness="1,1,0,0"><Border BorderBrush="{StaticResource HighlightBrush}" BorderThickness="0,0,1,1"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" /></Border></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="InputSurface" Property="BorderBrush" Value="{StaticResource AccentLineBrush}" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="InputSurface" Property="Background" Value="#E0DFE2" /><Setter Property="Foreground" Value="{StaticResource SubtleBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="MinHeight" Value="44" /><Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Setter Property="FontFamily" Value="Tahoma" /><Setter Property="FontSize" Value="14" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border x:Name="CheckSurface" Width="20" Height="20" VerticalAlignment="Center" Background="{StaticResource InsetBrush}" BorderBrush="{StaticResource DeepShadowBrush}" BorderThickness="1,1,0,0"><Border BorderBrush="{StaticResource HighlightBrush}" BorderThickness="0,0,1,1"><Path x:Name="CheckMark" Fill="{StaticResource AccentBrush}" Data="M2,7H4V9H6V7H8V5H10V3H12V5H10V7H8V9H6V11H4V9H2Z" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" RenderOptions.EdgeMode="Aliased" /></Border></Border><ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" /></Grid>
            <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckMark" Property="Visibility" Value="Visible" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckSurface" Property="BorderBrush" Value="{StaticResource AccentLineBrush}" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource SubtleBrush}" /><Setter TargetName="CheckSurface" Property="Background" Value="{StaticResource PanelBrush}" /><Setter Property="Cursor" Value="Arrow" /></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Slider">
        <Setter Property="MinHeight" Value="44" /><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Background="Transparent"><Border Height="4" Background="{StaticResource InsetBrush}" BorderBrush="{StaticResource DeepShadowBrush}" BorderThickness="1,1,0,0" VerticalAlignment="Center" /><Track x:Name="PART_Track" VerticalAlignment="Center" Height="44">
            <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False"><RepeatButton.Template><ControlTemplate><Grid Background="Transparent"><Border Height="2" Margin="0,0,-22,0" Background="{StaticResource AccentLineBrush}" /></Grid></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
            <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False"><RepeatButton.Template><ControlTemplate><Grid Background="Transparent" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
            <Track.Thumb><Thumb Width="44" Height="44" Cursor="Hand"><Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="Transparent"><Border x:Name="SliderGrip" Width="16" Height="24" Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource DeepShadowBrush}" BorderThickness="0,0,1,1"><Border BorderBrush="{StaticResource HighlightBrush}" BorderThickness="1,1,0,0"><Grid Width="4" Height="12"><Rectangle Width="1" Fill="{StaticResource LineBrush}" HorizontalAlignment="Left" /><Rectangle Width="1" Fill="{StaticResource HighlightBrush}" HorizontalAlignment="Right" /></Grid></Border></Border></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SliderGrip" Property="Background" Value="#DCE7FA" /></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="SliderGrip" Property="Background" Value="#CDDDF7" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
        </Track></Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.65" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
</ResourceDictionary>
